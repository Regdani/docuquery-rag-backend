# Provider selection: azure | gemini | ollama
LLM_PROVIDER=ollama
# Defaults to LLM_PROVIDER when empty or unset
EMBEDDING_PROVIDER=

# --- Azure OpenAI (primary cloud mode) ---
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_CHAT_DEPLOYMENT=
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- Google Gemini (API key from Google AI Studio) ---
# GOOGLE_API_KEY=
# GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Ollama (free local mode) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Data and index ---
INDEX_DIR=./data/index
DATA_DIR=./data/sample
CHROMA_COLLECTION=manuals

# --- Chunking and retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=4

# --- Timeouts, retries and limits ---
LLM_TIMEOUT_SECONDS=60
EMBEDDING_TIMEOUT_SECONDS=30
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=0.5
MAX_QUESTION_LENGTH=1000
MAX_CONCURRENT_REQUESTS=8
# Messages kept per session (human and assistant each count as one); in memory only
HISTORY_MAX_MESSAGES=20

LOG_LEVEL=INFO
