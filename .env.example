# Provider selection: azure | gemini | ollama
LLM_PROVIDER=ollama
# Defaults to LLM_PROVIDER when empty or unset
EMBEDDING_PROVIDER=

# --- Azure OpenAI (primary cloud mode) ---
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_CHAT_DEPLOYMENT=
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- Google Gemini (API key from Google AI Studio) ---
# GOOGLE_API_KEY=
# GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Ollama (free local mode) ---
# With Docker Compose the app service overrides this with http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Docker Compose ---
# Local mode (app + ollama): docker compose up --build -d
# Cloud mode (no ollama): set LLM_PROVIDER=azure or gemini plus its keys above, then run
#   docker compose --profile cloud up --build -d app-cloud
# Compose reads this file as .env (optional) and fixes INDEX_DIR and OLLAMA_BASE_URL itself.
# Host port of the API (container port is always 8000)
# APP_PORT=8000

# --- Data and index ---
INDEX_DIR=./data/index
DATA_DIR=./data/sample
CHROMA_COLLECTION=manuals

# --- Chunking and retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
# Number of chunks retrieved per question (1..20; anything else fails at startup)
RETRIEVAL_TOP_K=4
# Minimum relevance score (0..1) for a chunk to count as a hit; below it the answer is "no relevant information"
RETRIEVAL_RELEVANCE_THRESHOLD=0.3
# Maximum length of the snippet returned with each source
SNIPPET_MAX_CHARS=200

# --- Timeouts, retries and limits ---
LLM_TIMEOUT_SECONDS=60
EMBEDDING_TIMEOUT_SECONDS=30
# Timeout of the optional LLM reachability check (GET /health/ready?check_llm=true)
HEALTH_LLM_TIMEOUT_SECONDS=5
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=0.5
# Longest accepted question in characters (longer is a 422)
MAX_QUESTION_LENGTH=1000
# Retry-After (seconds) sent with 503 LLM_RATE_LIMITED when the provider does not say how long to wait
RATE_LIMIT_RETRY_AFTER_SECONDS=5
MAX_CONCURRENT_REQUESTS=8
# Messages kept per session (human and assistant each count as one); in memory only
HISTORY_MAX_MESSAGES=20

# DEBUG, INFO, WARNING, ERROR or CRITICAL; logs go to stdout
LOG_LEVEL=INFO
# Questions are logged truncated to this many characters
LOG_QUESTION_MAX_CHARS=80
